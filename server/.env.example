PORT=3333
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Proxies reversos na frente da API (0 = acesso direto/LAN; 1 = um proxy, ex.: Traefik)
TRUST_PROXY_HOPS=0
# Horas sem atividade até a sala ser arquivada
ROOM_TTL_HOURS=24
# true habilita o Key Relay (envio de teclas na máquina do servidor)
KEY_RELAY_AVAILABLE=false
MASTER_USER=
MASTER_PASSWORD=
ANALYTICS_DB_PATH=data/analytics.db
TELEMETRY_URL=https://api-luzes-ipf.assist.com.br
# false desliga o envio de diagnósticos
TELEMETRY_ENABLED=true
