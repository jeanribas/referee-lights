PORT=3333
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (0 = direct/LAN; 1 = Traefik)
TRUST_PROXY_HOPS=0
MASTER_USER=
MASTER_PASSWORD=
ANALYTICS_DB_PATH=data/analytics.db
TELEMETRY_URL=https://api.refereelights.app
# false desliga o envio de diagnósticos
TELEMETRY_ENABLED=true
